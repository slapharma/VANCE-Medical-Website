# Copy to `.env.local` for local development (gitignored).
# Set these on Vercel → Project → Settings → Environment Variables for
# Production + Preview.

# ----- Gmail / Google Workspace SMTP --------------------------------------
# The contact form and newsletter signup deliver messages via this account.
# Required for production; if absent, the actions fall back to console.log
# so the UI stays testable.

# === IMPORTANT for Workspace alias users ===
# If the inbox you want messages to APPEAR FROM is a Workspace ALIAS
# (e.g. contact@vancemedicalfoods.co.uk → routes to your primary user
# cflack@slapharmagroup.com), authenticate as the PRIMARY user — App
# Passwords are tied to primary accounts, not aliases. Set GMAIL_FROM to
# the alias separately. The alias must also be registered as a "Send
# mail as" identity in the primary user's Gmail settings (Settings →
# Accounts and Import → Send mail as → Add another email address);
# Workspace aliases are usually auto-registered, but verify.

# Primary Workspace user that holds the App Password.
# Example: cflack@slapharmagroup.com
GMAIL_USER=

# 16 characters, no spaces.
# Generate at https://myaccount.google.com/apppasswords (signed in as the
# GMAIL_USER above). Requires 2-Step Verification enabled on that account.
GMAIL_APP_PASSWORD=

# What recipients see in the From header. Must be either GMAIL_USER itself
# or an alias / Send-Mail-As identity on that account.
# Example: contact@vancemedicalfoods.co.uk
GMAIL_FROM=

# Optional: where contact-form messages and newsletter signups are
# delivered. Default to GMAIL_USER (so they land in your primary inbox).
# Setting these to the alias works fine — Workspace routes alias mail to
# the primary user, but tagging by destination address makes inbox
# filtering / labelling easier.
CONTACT_TO=
NEWSLETTER_TO=

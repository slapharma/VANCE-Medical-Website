# Copy to `.env.local` for local development (gitignored).
# Set these on Vercel → Project → Settings → Environment Variables for
# Production + Preview.

# ----- Gmail / Google Workspace SMTP --------------------------------------
# The contact form and newsletter signup deliver messages via this account.
# Required for production; if absent, the actions fall back to console.log
# so the UI stays testable.

# Sending account (must match the App Password owner). Typically the inbox
# you also want to receive at — Gmail's most reliable path is to authenticate
# as the same address you're sending from.
GMAIL_USER=contact@vancemedical.co.uk

# Generate at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the account first.
# 16 characters, no spaces.
GMAIL_APP_PASSWORD=

# Optional: override the From header (must be an alias the GMAIL_USER
# account is permitted to send as). Defaults to GMAIL_USER.
# GMAIL_FROM=contact@vancemedical.co.uk

# Optional: override delivery destinations. Default to GMAIL_USER.
# CONTACT_TO=contact@vancemedical.co.uk
# NEWSLETTER_TO=contact@vancemedical.co.uk
